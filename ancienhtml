<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  :root {
    --fond: #04120C;
    --panneau: #0B2B20;
    --panneau2: #0E3527;
    --or: #FFC72C;
    --blanc: #FFFFFF;
    --vert-clair: #7BC9A3;
  }
  html { scroll-behavior: smooth; }
  body {
    color: var(--blanc);
    font-family: 'Work Sans', sans-serif;
    line-height: 1.55;
    background:
      radial-gradient(1100px 520px at 85% -80px, rgba(255, 199, 44, .09), transparent 60%),
      radial-gradient(900px 500px at -10% 30%, rgba(16, 120, 70, .16), transparent 55%),
      var(--fond);
  }
  img { max-width: 100%; }
  .js .r { opacity: 0; transform: translateY(18px); transition: opacity .6s ease, transform .6s ease; }
  .js .r.vu { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .js .r { opacity: 1; transform: none; transition: none; }
  }

  /* ===== Header ===== */
  header {
    position: sticky; top: 0; z-index: 100;
    background: rgba(4, 18, 12, 0.96);
    border-bottom: 2px solid var(--or);
    backdrop-filter: blur(6px);
  }
  .barre { max-width: 1200px; margin: 0 auto; padding: 8px 18px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .logo-boite { display: flex; align-items: center; gap: 12px; text-decoration: none; }
  .logo-boite img { width: 48px; height: 48px; object-fit: contain; filter: drop-shadow(0 0 10px rgba(255,199,44,.35)); }
  .logo { font-family: 'Bebas Neue', sans-serif; font-size: 1.55rem; letter-spacing: 2px; color: var(--blanc); }
  .logo span { color: var(--or); }
  nav { margin-left: auto; display: flex; gap: 6px; flex-wrap: wrap; }
  nav a { color: var(--blanc); text-decoration: none; font-weight: 600; font-size: .87rem; padding: 7px 11px; border-radius: 8px; transition: background .15s ease, color .15s ease; }
  nav a:hover { background: var(--or); color: #0B2B20; }

  /* ===== Bandeau défilant ===== */
  .defilant {
    overflow: hidden; white-space: nowrap;
    background: linear-gradient(90deg, #0A2418, #0E3527, #0A2418);
    border-bottom: 1px solid rgba(255,199,44,.35);
    padding: 6px 0;
  }
  .defilant .piste { display: inline-block; animation: defile 36s linear infinite; }
  .defilant span {
    font-family: 'Bebas Neue', sans-serif; letter-spacing: 2.5px; font-size: .92rem;
    color: rgba(255,255,255,.75); margin-right: 14px;
  }
  .defilant b { color: var(--or); font-weight: 400; margin-right: 14px; }
  @keyframes defile { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  /* ===== Hero ===== */
  .hero { position: relative; overflow: hidden; border-bottom: 4px solid var(--or); }
  .hero img.fond-arena { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: brightness(.4) saturate(1.08); }
  .hero .voile { position: absolute; inset: 0; background: linear-gradient(92deg, rgba(4,18,12,.94) 0%, rgba(4,18,12,.6) 52%, rgba(4,18,12,.22) 100%); }
  .hero .mot-geant {
    position: absolute; left: 0; right: 0; bottom: 4px; text-align: center;
    font-family: 'Bebas Neue', sans-serif; font-size: clamp(4rem, 14.5vw, 12.5rem); line-height: .8;
    color: transparent; -webkit-text-stroke: 1.5px rgba(255,255,255,.13);
    letter-spacing: 6px; pointer-events: none; user-select: none;
  }
  .hero .filigrane {
    position: absolute; right: -24px; top: 46%; transform: translateY(-50%);
    width: min(520px, 58vw); opacity: .17; pointer-events: none;
  }
  .hero .contenu { position: relative; max-width: 1200px; margin: 0 auto; padding: 88px 18px 118px; }
  .kicker {
    display: inline-block; font-weight: 800; letter-spacing: 2.5px; font-size: .78rem;
    color: #14301F; background: linear-gradient(90deg, #FFD34D, var(--or));
    padding: 6px 14px; border-radius: 4px; transform: skewX(-8deg);
    box-shadow: 0 8px 20px -8px rgba(255,199,44,.8);
    animation: entree .6s ease both;
  }
  h1 { font-family: 'Bebas Neue', sans-serif; font-size: clamp(4rem, 11vw, 8.6rem); line-height: .92; letter-spacing: 3px; margin-top: 18px; text-shadow: 0 12px 44px rgba(0,0,0,.6); animation: entree .6s .08s ease both; }
  h1 span {
    background: linear-gradient(100deg, #B8860B 0%, var(--or) 35%, #FFF3C4 50%, var(--or) 65%, #B8860B 100%);
    background-size: 220% 100%;
    -webkit-background-clip: text; background-clip: text; color: transparent;
    animation: brillance 5s linear infinite;
  }
  @keyframes brillance { from { background-position: 200% 0; } to { background-position: -20% 0; } }
  .hero p.accroche { max-width: 640px; margin-top: 16px; font-size: 1.16rem; font-weight: 500; animation: entree .6s .16s ease both; }
  .puces-hero { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 20px; animation: entree .6s .22s ease both; }
  .puce-hero {
    background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.25);
    backdrop-filter: blur(4px); border-radius: 999px; padding: 6px 14px;
    font-size: .83rem; font-weight: 700; letter-spacing: .6px;
  }
  .puce-hero b { color: var(--or); font-weight: 800; }
  .hero .actions { margin-top: 26px; display: flex; gap: 12px; flex-wrap: wrap; animation: entree .6s .3s ease both; }
  .btn { display: inline-block; text-decoration: none; font-weight: 800; border-radius: 8px; padding: 13px 24px; font-size: .98rem; letter-spacing: .3px; transition: transform .15s ease, filter .15s ease, box-shadow .15s ease; }
  .btn-or {
    background: linear-gradient(180deg, #FFD34D, #F0AC0A); color: #14301F;
    box-shadow: 0 12px 26px -10px rgba(255,199,44,.75), 0 0 22px -6px rgba(255,199,44,.55);
  }
  .btn-or:hover { box-shadow: 0 16px 30px -10px rgba(255,199,44,.85), 0 0 30px -4px rgba(255,199,44,.7); }
  .btn-fantome { background: rgba(255,255,255,.07); color: var(--blanc); border: 1px solid rgba(255,255,255,.35); }
  .btn:hover { transform: translateY(-2px); filter: brightness(1.08); }
  @keyframes entree { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }

  /* ===== Centre de match ===== */
  .matchcentre-cont { max-width: 1200px; margin: -56px auto 0; padding: 0 18px; position: relative; z-index: 6; }
  .matchcentre {
    border-radius: 18px; overflow: hidden;
    border: 1px solid rgba(255,199,44,.55);
    background:
      repeating-linear-gradient(-55deg, rgba(255,199,44,.045) 0 14px, transparent 14px 28px),
      linear-gradient(180deg, #123C2B, #071F15);
    box-shadow: 0 24px 44px -18px rgba(0,0,0,.9), 0 0 40px -8px rgba(255,199,44,.4);
  }
  .mc-haut { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 10px; padding: 26px 28px 6px; }
  .mc-equipe { display: flex; align-items: center; gap: 16px; }
  .mc-equipe.droite { justify-content: flex-end; text-align: right; }
  .mc-equipe img { width: 84px; height: 84px; object-fit: contain; filter: drop-shadow(0 6px 18px rgba(0,0,0,.55)); }
  .mc-nom { font-family: 'Bebas Neue', sans-serif; font-size: clamp(1.8rem, 4.2vw, 3rem); line-height: .95; letter-spacing: 1.5px; }
  .mc-nom span { color: var(--or); }
  .mc-vs {
    font-family: 'Bebas Neue', sans-serif; font-size: clamp(2.2rem, 5vw, 3.6rem); color: #0B2B20;
    background: linear-gradient(180deg, #FFD34D, #F0AC0A); border-radius: 50%;
    width: 92px; height: 92px; display: flex; align-items: center; justify-content: center;
    box-shadow: 0 0 34px -4px rgba(255,199,44,.75); border: 3px solid rgba(255,255,255,.25);
  }
  .mc-date { text-align: center; font-weight: 800; letter-spacing: 2px; font-size: .86rem; color: var(--vert-clair); text-transform: uppercase; padding: 8px 18px 0; }
  .mc-date b { color: var(--blanc); }
  .cases { display: flex; gap: 10px; justify-content: center; padding: 12px 18px 4px; flex-wrap: wrap; }
  .case { text-align: center; background: rgba(0,0,0,.4); border: 1px solid rgba(255,199,44,.3); border-radius: 10px; padding: 8px 12px; min-width: 72px; }
  .case .n { font-family: 'Bebas Neue', sans-serif; font-size: 2.1rem; line-height: 1; color: var(--or); }
  .case .u { font-size: .66rem; letter-spacing: 1.6px; font-weight: 700; color: #D8EFE2; text-transform: uppercase; }
  .mc-bas {
    display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
    padding: 16px 28px 22px; margin-top: 8px;
    border-top: 1px solid rgba(255,255,255,.1);
    font-weight: 600; font-size: .95rem;
  }
  .mc-bas .btn { margin-left: auto; padding: 10px 18px; font-size: .9rem; }

  /* ===== Sections ===== */
  section { max-width: 1200px; margin: 0 auto; padding: 60px 18px 8px; }
  .kick { font-weight: 800; letter-spacing: 3px; font-size: .74rem; color: var(--or); text-transform: uppercase; margin-bottom: 4px; }
  h2 { font-family: 'Bebas Neue', sans-serif; font-size: clamp(2.2rem, 4.6vw, 3.2rem); letter-spacing: 1.5px; margin-bottom: 6px; }
  h2::after { content: ""; display: block; width: 74px; height: 4px; margin-top: 8px; border-radius: 2px; background: linear-gradient(90deg, var(--or), rgba(255,199,44,0)); }
  .sous-titre { color: var(--vert-clair); font-weight: 600; margin-bottom: 22px; }
  .carte { position: relative; background: linear-gradient(180deg, var(--panneau2), var(--panneau)); border: 1px solid rgba(255,255,255,.1); border-radius: 16px; box-shadow: 0 18px 34px -16px rgba(0,0,0,.85); }
  .carte.brille { overflow: hidden; }
  .carte.brille::after {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(115deg, transparent 30%, rgba(255,255,255,.09) 48%, transparent 62%);
    transform: translateX(-130%); transition: transform .8s ease;
  }
  .carte.brille:hover::after { transform: translateX(130%); }

  /* ===== Le joueur ===== */
  .joueur { display: grid; grid-template-columns: 400px 1fr; gap: 22px; align-items: stretch; }
  .photo-joueur { overflow: hidden; border-radius: 16px; border: 1px solid rgba(255,199,44,.4); box-shadow: 0 0 34px -8px rgba(255,199,44,.45); }
  .photo-joueur img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .fiche { padding: 24px; }
  .fiche-grille { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px 26px; margin-top: 6px; }
  .champ .etiquette { font-size: .78rem; font-weight: 700; letter-spacing: 1.2px; color: var(--or); text-transform: uppercase; }
  .champ .valeur { font-size: 1.06rem; font-weight: 600; margin-top: 2px; }
  .citation { margin-top: 22px; padding: 18px 20px; border-left: 4px solid var(--or); background: rgba(255,199,44,.06); border-radius: 0 12px 12px 0; }
  .citation p { font-size: .99rem; }
  .citation .source { margin-top: 8px; font-size: .82rem; color: var(--vert-clair); font-weight: 600; }

  /* ===== En chiffres ===== */
  .chiffres { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .chiffre { padding: 24px 18px; text-align: center; overflow: hidden; }
  .chiffre .nombre { font-family: 'Bebas Neue', sans-serif; font-size: 3.6rem; line-height: 1; color: var(--or); text-shadow: 0 0 26px rgba(255,199,44,.35); }
  .chiffre .desc { margin-top: 6px; font-weight: 600; font-size: .92rem; }
  .reperes { margin-top: 16px; padding: 20px 24px; }
  .reperes h3 { font-family: 'Bebas Neue', sans-serif; letter-spacing: 1.2px; font-size: 1.3rem; margin-bottom: 10px; }
  .reperes ul { list-style: none; }
  .reperes li { padding: 7px 0 7px 20px; position: relative; border-bottom: 1px solid rgba(255,255,255,.07); font-weight: 500; }
  .reperes li:last-child { border-bottom: none; }
  .reperes li::before { content: ""; position: absolute; left: 0; top: 15px; width: 8px; height: 8px; border-radius: 50%; background: var(--or); box-shadow: 0 0 10px rgba(255,199,44,.7); }

  /* ===== Tableaux ===== */
  .tableau { overflow-x: auto; border-radius: 16px; }
  table { width: 100%; border-collapse: collapse; min-width: 640px; }
  th, td { padding: 11px 13px; text-align: right; font-size: .95rem; white-space: nowrap; }
  th:first-child, td:first-child { text-align: left; }
  thead th { background: #0E3527; color: var(--or); font-weight: 700; letter-spacing: .4px; border-bottom: 2px solid var(--or); }
  tbody tr { border-bottom: 1px solid rgba(255,255,255,.07); }
  tbody tr:nth-child(even) { background: rgba(255,255,255,.03); }
  tbody tr.total { background: rgba(255,199,44,.1); font-weight: 700; }
  tbody tr.a-venir { background: rgba(255,199,44,.12); font-weight: 700; color: var(--or); }
  .note { margin-top: 10px; font-size: .84rem; color: var(--vert-clair); font-weight: 500; }

  /* ===== Effectif ===== */
  .filtres { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 20px; }
  .filtre {
    background: rgba(255,255,255,.05); color: var(--blanc);
    border: 1px solid rgba(255,255,255,.18); border-radius: 999px;
    padding: 8px 16px; font-family: 'Work Sans', sans-serif; font-weight: 700; font-size: .85rem;
    cursor: pointer; transition: all .15s ease;
  }
  .filtre:hover { border-color: var(--or); }
  .filtre.actif { background: var(--or); color: #0B2B20; border-color: var(--or); }
  .filtre .n { opacity: .65; font-weight: 600; }
  .effectif { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; }
  .jcarte {
    position: relative; overflow: hidden; display: block; width: 100%; text-align: left; cursor: pointer;
    background: linear-gradient(160deg, rgba(255,255,255,.05), rgba(255,255,255,.015) 55%), linear-gradient(180deg, var(--panneau2), var(--panneau));
    border: 1px solid rgba(255,255,255,.1); border-radius: 14px; padding: 20px;
    color: var(--blanc); font-family: 'Work Sans', sans-serif;
    transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
  }
  .jcarte:hover, .jcarte:focus-visible {
    transform: translateY(-4px); border-color: rgba(255,199,44,.7);
    box-shadow: 0 16px 30px -14px rgba(0,0,0,.9), 0 0 24px -6px rgba(255,199,44,.45);
    outline: none;
  }
  .jcarte .fantome {
    position: absolute; right: 10px; bottom: -16px; font-family: 'Bebas Neue', sans-serif;
    font-size: 5.4rem; line-height: 1; color: rgba(255,255,255,.05); pointer-events: none; letter-spacing: 1px;
  }
  .jcarte.vedette { border-color: rgba(255,199,44,.55); box-shadow: 0 0 22px -8px rgba(255,199,44,.5); }
  .jcarte .jphoto {
    position: absolute; right: 0; top: 0; height: 100%; width: 46%; object-fit: cover;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 55%);
    mask-image: linear-gradient(90deg, transparent, #000 55%);
  }
  .jcarte .jnom { display: block; font-family: 'Bebas Neue', sans-serif; font-size: 1.55rem; letter-spacing: .5px; line-height: 1.05; position: relative; }
  .jcarte .jpos { display: block; margin-top: 5px; color: var(--or); font-weight: 700; font-size: .72rem; letter-spacing: 1.6px; text-transform: uppercase; position: relative; }
  .jcarte .jvit { display: block; margin-top: 12px; font-size: .88rem; font-weight: 600; position: relative; }
  .jcarte .jville { display: block; margin-top: 3px; font-size: .82rem; font-weight: 500; color: var(--vert-clair); position: relative; }
  .jcarte.vedette .jnom, .jcarte.vedette .jpos, .jcarte.vedette .jvit, .jcarte.vedette .jville { max-width: 62%; }
  .medaillon {
    flex: none; width: 52px; height: 52px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: radial-gradient(circle at 32% 30%, #1A5C3D, #0B2B20);
    border: 2px solid rgba(255,199,44,.6);
    font-family: 'Bebas Neue', sans-serif; font-size: 1.35rem; color: var(--or);
  }

  /* ===== Modale joueur ===== */
  .modale-fond {
    position: fixed; inset: 0; z-index: 200; display: none;
    background: rgba(2, 8, 5, .8); align-items: center; justify-content: center; padding: 18px;
  }
  .modale-fond.ouvert { display: flex; }
  .modale {
    width: min(620px, 100%); max-height: 88vh; overflow-y: auto;
    background: linear-gradient(180deg, #123C2B, #08231A);
    border: 1px solid rgba(255,199,44,.55); border-radius: 18px;
    box-shadow: 0 0 44px -8px rgba(255,199,44,.5); padding: 26px;
  }
  .modale .m-haut { display: flex; gap: 18px; align-items: center; }
  .modale .medaillon { width: 76px; height: 76px; font-size: 2rem; }
  .modale h3 { font-family: 'Bebas Neue', sans-serif; font-size: 2.4rem; letter-spacing: 1px; line-height: 1; }
  .modale .m-pos { color: var(--or); font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; font-size: .85rem; margin-top: 4px; }
  .modale .m-grille { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px 24px; margin-top: 20px; }
  .modale .m-note { margin-top: 18px; padding: 14px 16px; background: rgba(255,199,44,.08); border-left: 4px solid var(--or); border-radius: 0 10px 10px 0; font-weight: 500; }
  .modale .m-actions { margin-top: 20px; display: flex; gap: 10px; flex-wrap: wrap; }
  .fermer {
    float: right; background: rgba(255,255,255,.08); color: var(--blanc);
    border: 1px solid rgba(255,255,255,.25); border-radius: 8px; padding: 6px 13px;
    font-weight: 700; cursor: pointer; font-family: 'Work Sans', sans-serif;
  }
  .fermer:hover { background: var(--or); color: #0B2B20; }

  /* ===== Relève et légendes ===== */
  .releve { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .releve .carte { padding: 22px; }
  .releve h3 { font-family: 'Bebas Neue', sans-serif; letter-spacing: 1px; font-size: 1.6rem; }
  .releve .surnom { color: var(--or); font-weight: 700; letter-spacing: 1px; font-size: .8rem; text-transform: uppercase; }
  .releve p { margin-top: 8px; font-weight: 500; font-size: .96rem; }
  .legendes { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .legendes .carte { padding: 24px; overflow: hidden; }
  .legendes .num-retire {
    position: absolute; right: 14px; top: 6px;
    font-family: 'Bebas Neue', sans-serif; font-size: 5rem; line-height: 1;
    color: rgba(255,199,44,.14); pointer-events: none;
  }
  .legendes h3 { font-family: 'Bebas Neue', sans-serif; letter-spacing: 1px; font-size: 1.8rem; }
  .legendes .annees { color: var(--or); font-weight: 700; font-size: .85rem; letter-spacing: 1px; }
  .legendes p { margin-top: 8px; font-weight: 500; }
  .legendes .fait { margin-top: 10px; font-weight: 700; color: var(--vert-clair); font-size: .92rem; }

  /* ===== Club, histoire, suivi ===== */
  .club-grille { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .club-carte { padding: 22px; }
  .club-carte h3 { font-family: 'Bebas Neue', sans-serif; letter-spacing: 1.2px; font-size: 1.35rem; color: var(--or); margin-bottom: 8px; }
  .club-carte p { font-weight: 500; }
  .histoire { margin-top: 18px; padding: 24px; }
  .histoire h3 { font-family: 'Bebas Neue', sans-serif; letter-spacing: 1.2px; font-size: 1.35rem; margin-bottom: 12px; }
  .jalon { display: flex; gap: 16px; padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,.07); }
  .jalon:last-child { border-bottom: none; }
  .jalon .an { flex: none; width: 74px; font-family: 'Bebas Neue', sans-serif; font-size: 1.5rem; color: var(--or); }
  .jalon p { font-weight: 500; }
  .suivi { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .suivi .carte { padding: 20px; }
  .suivi .quand { color: var(--or); font-weight: 700; letter-spacing: 1px; font-size: .8rem; text-transform: uppercase; }
  .suivi .qui { font-family: 'Bebas Neue', sans-serif; font-size: 1.5rem; letter-spacing: .6px; margin-top: 4px; }
